11\" data-check-id=\"type1-11\"> <span><em>眼尖</em></span></label></li><li class=\"check-item\"><label for=\"type1-12\"><input type=\"checkbox\" class=\"wiki-check\" id=\"type1-12\" data-check-id=\"type1-12\"> <span><em>鼻子灵</em></span></label></li><li class=\"check-item\"><label for=\"type1-13\"><input type=\"checkbox\" class=\"wiki-check\" id=\"type1-13\" data-check-id=\"type1-13\"> <span><em>迅疾</em></span></label></li><li class=\"check-item\"><label for=\"type1-14\"><input type=\"checkbox\" class=\"wiki-check\" id=\"type1-14\" data-check-id=\"type1-14\"> <span><em>隐秘</em></span></label></li><li class=\"check-item\"><label for=\"type1-15\"><input type=\"checkbox\" class=\"wiki-check\" id=\"type1-15\" data-check-id=\"type1-15\"> <span><em>臭烘烘</em></span></label></li><li class=\"check-item\"><label><input type=\"checkbox\" checked disabled aria-label=\"起始已勾选\"> <span><em>微小</em></span></label></li><li class=\"check-item\"><label for=\"type1-17\"><input type=\"checkbox\" class=\"wiki-check\" id=\"type1-17\" data-check-id=\"type1-17\"> <span><em>惯偷</em></span></label></li><li class=\"check-item\"><label for=\"type1-blank0\"><input type=\"checkbox\" class=\"wiki-check\" id=\"type1-blank0\" data-check-id=\"type1-blank0\"></label><input type=\"text\" class=\"wiki-field\" data-field-key=\"animal-companion:type1-blank0\" placeholder=\"write in\" aria-label=\"自行填写\" autocomplete=\"off\"></li></ul>\n</div><div class=\"fs-type\">\n<div class=\"fs-type-head\"><label for=\"ac-type2-pick\"><input type=\"checkbox\" class=\"wiki-check\" id=\"ac-type2-pick\" data-check-id=\"type2-pick\"> <strong>蛮兽</strong></label> <span class=\"fs-muted\">（熊、野猪、貂熊、原牛、地行龙， <input type=\"text\" class=\"wiki-field\" data-field-key=\"animal-companion:type2-other\" placeholder=\"…\" aria-label=\"…\" autocomplete=\"off\">)</span></div>\n<p class=\"stat-line\">HP 12；护甲 0；伤害 d6（<em>近身</em>)</p>\n<p class=\"fs-muted\">再选3项：</p>\n<ul class=\"check-list fs-picks\"><li class=\"check-item\"><label for=\"type2-0\