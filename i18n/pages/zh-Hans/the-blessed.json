  "title": "蒙福者",
  "nav_label": "蒙福者",
  "description": "石顶（Stonetop）蒙福者剧本：达努的选民，怀圣囊、通灵语、主持大地圣仪，包含背景、行动与相互介绍。",
  "sections": {
    "background-choose-1": "背景（选1）",
    "instinct-choose-1": "本能（选1）",
    "appearance": "外貌",
    "place-of-origin-and-name": "出身与姓名",
    "stats": "属性",
    "special-possessions-pick-2-in-addition-to-your-sacred-pouch": "特殊财物（除圣囊外，另选2）",
