  "title": "Der Marschall",
  "nav_label": "Der Marschall",
  "description": "Das Spielbuch des Marschalls für Stonetop — Anführer von Miliz und Trupp, mit Hintergründen, Spielzügen und den Kriegsgeschichten des Dorfes.",
  "sections": {
    "background-choose-1": "Hintergrund (Wähle 1)",
    "instinct-choose-1": "Instinkt (Wähle 1)",
    "appearance": "Aussehen",
    "place-of-origin-and-name": "Herkunft und Name",
    "stats": "Werte",
    "special-possessions-pick-2": "Besondere Besitztümer (Wähle 2)",
    "moves": "Spielzüge",
