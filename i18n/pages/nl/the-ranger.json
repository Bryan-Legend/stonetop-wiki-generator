  "title": "De Woudloper",
  "nav_label": "De Woudloper",
  "description": "Het playbook van de Woudloper voor Stonetop: jager en verkenner van de wildernis voorbij de Ringmuur, met achtergronden, zetten en dierenmetgezel.",
  "sections": {
    "background-choose-1": "Achtergrond (Kies er 1)",
    "instinct-choose-1": "Instinct (Kies er 1)",
    "appearance": "Uiterlijk",
    "place-of-origin-and-name": "Herkomst en naam",
    "stats": "Waarden",
    "special-possessions-pick-2-in-addition-to-your-composite-bow": "Bijzondere bezittingen (Kies er 2, naast je composietboog)",
    "moves": "Zetten",
