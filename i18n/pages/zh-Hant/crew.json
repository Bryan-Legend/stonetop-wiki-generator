crew-supplies-c-6\" data-check-id=\"crew-supplies-c-6\" aria-label=\"第7份\"></label><label class=\"track-step\" for=\"crew-supplies-c-7\" title=\"第8份\"><input type=\"checkbox\" class=\"wiki-check\" id=\"crew-supplies-c-7\" data-check-id=\"crew-supplies-c-7\" aria-label=\"第8份\"></label></span></div></div>\n<div class=\"fs-field fs-gear\"><span class=\"fs-label\">其他裝備</span><ul><li><input type=\"text\" class=\"wiki-field\" data-field-key=\"crew:gear0\" autocomplete=\"off\"></li><li><input type=\"text\" class=\"wiki-field\" data-field-key=\"crew:gear1\" autocomplete=\"off\"></li><li><input type=\"text\" class=\"wiki-field\" data-field-key=\"crew:gear2\" autocomplete=\"off\"></li><li><input type=\"text\" class=\"wiki-field\" data-field-key=\"crew:gear3\" autocomplete=\"off\"></li><li><input type=\"text\" class=\"wiki-field\" data-field-key=\"crew:gear4\" autocomplete=\"off\"></li><li><input type=\"text\" class=\"wiki-field\" data-field-key=\"crew:gear5\" autocomplete=\"off\"></li></ul></div>\n<h3 id=\"individuals\">個別成員</h3>\n<p>當有人嶄露頭角時，給他取個名字，配一個標籤和一項或多項特質。</p>\n<div class=\"fs-people\"><div class=\"fs-person\"><div class=\"fs-field\"><span class=\"fs-label\">姓名</span><input type=\"text\" class=\"wiki-field\" data-field-key=\"crew:ind0-name\" placeholder=\"name\" aria-label=\"姓名\" autocomplete=\"off\"></div><div class=\"fs-field\"><span class=\"fs-label\">標籤</span><input type=\"text\" class=\"wiki-field\" data-field-key=\"crew:ind0-tag\" placeholder=\"tag\" aria-label=\"標籤\" autocomplete=\"off\"></div><div class=\"fs-field\"><span class=\"fs-label\">特質</span><input type=\"text\" class=\"wiki-field\" data-field-key=\"crew:ind0-traits\" placeholder=\"traits\" aria-label=\"特質\" autocomplete=\"off\"></div></div><div class=\"fs-person\"><div class=\"fs-field\"><span class=\"fs-label\">姓名</span><input type=\"text\" class=\"wiki-field\" data-field-key=\"crew:ind1-name\" placeholder=\"name\" aria-label=\"姓名\" autocomplete=\"off\"></div><div class=\"fs-field\"><span class=\"fs-label\">標籤</span><input type=\"text\" class=\"wiki-field\" data-field-key=\"crew:ind1-tag\" placeholder=\"tag\" aria-label=\"標籤\" autocomplete=\"off\"></div><div class=\"fs-field\"><span class=\"fs-label\">特質</span><input type=\"text\" class=\"wiki-field\" data-field-key=\"crew:ind1-traits\" placeholder=\"traits\" aria-label=\"特質\" autocomplete=\"off\"></div></div><div class=\"fs-person\"><div class=\"fs-field\"><span class=\"fs-label\">姓名</span><input type=\"text\" class=\"wiki-field\" data-field-key=\"crew:ind2-name\" placeholder=\"name\" aria-label=\"姓名\" autocomplete=\"off\"></div><div class=\"fs-field\"><span class=\"fs-label\">標籤</span><input type=\"text\" class=\"wiki-field\" data-field-key=\"crew:ind2-tag\" placeholder=\"tag\" aria-label=\"標籤\" autocomplete=\"off\"></div><div class=\"fs-field\"><span class=\"fs-label\">特質</span><input type=\"text\" class=\"wiki-field\" data-field-key=\"crew:ind2-traits\" placeholder=\"traits\" aria-label=\"特質\" autocomplete=\"off\"></div></div><div class=\"fs-person\"><div class=\"fs-field\"><span class=\"fs-label\">姓名</span><input type=\"text\" class=\"wiki-field\" data-field-key=\"crew:ind3-name\" placeholder=\"name\" aria-label=\"姓名\" autocomplete=\"off\"></div><div class=\"fs-field\"><span class=\"fs-label\">標籤</span><input type=\"text\" class=\"wiki-field\" data-field-key=\"crew:ind3-tag\" placeholder=\"tag\" aria-label=\"標籤\" autocomplete=\"off\"></div><div class=\"fs-field\"><span class=\"fs-label\">特質</span><input type=\"text\" class=\"wiki-field\" data-field-key=\"crew:ind3-traits\" placeholder=\"traits\" aria-label=\"特質\" autocomplete=\"off\"></div></div><div class=\"fs-person\"><div class=\"fs-field\"><span class=\"fs-label\">姓名</span><input type=\"text\" class=\"wiki-field\" data-field-key=\"crew:ind4-name\" placeholder=\"name\" aria-label=\"姓名\" autocomplete=\"off\"></div><div class=\"fs-field\"><span class=\"fs-label\">標籤</span><input type=\"text\" class=\"wiki-field\" data-field-key=\"crew:ind4-tag\" placeholder=\"tag\" aria-label=\"標籤\" autocomplete=\"off\"></div><div class=\"fs-field\"><span class=\"fs-label\">特質</span><input type=\"text\" class=\"wiki-field\" data-field-key=\"crew:ind4-traits\" placeholder=\"traits\" aria-label=\"特質\" autocomplete=\"off\"></div></div><div class=\"fs-person\"><div class=\"fs-field\"><span class=\"fs-label\">姓名</span><input type=\"text\" class=\"wiki-field\" data-field-key=\"crew:ind5-name\" placeholder=\"name\" aria-label=\"姓名\" autocomplete=\"off\"></div><div class=\"fs-field\"><span class=\"fs-label\">標籤</span><input type=\"text\" class=\"wiki-field\" data-field-key=\"crew:ind5-tag\" placeholder=\"tag\" aria-label=\"標籤\" autocomplete=\"off\"></div><div class=\"fs-field\"><span class=\"fs-label\">特質</span><input type=\"text\" class=\"wiki-field\" data-field-key=\"crew:ind5-traits\" placeholder=\"traits\" aria-label=\"特質\" autocomplete=\"off\"></div></div></div>\n<p><strong>名字：</strong> 阿萊德、庫爾威奇、艾拉、格拉特、格勞、哈里、洛里、梅爾文、內絲塔</p>\n<p><strong>標籤：</strong> <em>愛惜牲口、塊頭大、橫行霸道、憤世嫉俗、酒鬼、幹勁十足、好賭、貪財、脾氣壞、耳根子軟、萬人迷、老實、心善、下流、個頭小、天真、年邁、人緣好、心高氣傲、新手、莽撞、不知羞、目光銳利、火氣大</em></p>\n<p><strong>特質：</strong> ___的孩子/手足/爹娘/表親/___、禿頭、暗戀___、記恨___、憎惡___、崇拜___、愛說笑、邋遢、缺了眼睛/手指/手/___、想念自家孩子、做惡夢、新婚不久、虔誠、帶疤、精瘦、嘴毒、愛唱歌、打鼾、愛吹牛、太嚴肅、家裡不順、愛吹口哨、愛削木頭</p>\n<div class=\"fs-field fs-notes\"><span class=\"fs-label\">備註</span><textarea class=\"wiki-field\" data-field-key=\"crew:notes\" rows=\"3\" aria-label=\"備註\"></textarea></div>\n</div>\n<h3 id=\"order-followers\">號令追隨者</h3>\n<p>當你 <strong><em>指使他們做出某個行動、而他們照做</em></strong>時，若其任一標籤適用，擲 +1 而非 +屬性（若他們還是 <em>卓異</em>的，則擲 +2）。若無標籤適用，擲 +0。若其任一標籤會礙事，擲骰帶劣勢。</p>\n<p>當他們 <strong><em>沒有得到指令</em></strong> 或 <strong><em>自作主張行事</em></strong>時，由GM決定他們做什麼、結果如何。</p>\n<h3 id=\"strengthen-your-bond\">加深羈絆</h3>\n<p>當你 <strong><em>付出他們的代價</em></strong> 且近來未曾付出過時，他們持有 +1 忠誠（上限3）。</p>\n<p>按1比1花費其忠誠，可讓他們：</p>\n<ul class=\"bullets\"><li>克服恐懼，照你說的做</li><li>克制住不按其本能/標籤/特質行事</li><li>去做他們不願做的事（只要不是傷天害理或自尋死路）</li></ul>"
}
